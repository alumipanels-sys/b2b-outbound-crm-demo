# ── Server ──────────────────────────────
HOST=0.0.0.0
PORT=8010

# Demo build: true keeps the "Reset demo data" button available in System
# Settings, so you can restore the sample workspace at any time.
DEMO_MODE=true

# ── Company identity (also editable in System Settings) ──
COMPANY_NAME=
USER_NAME=
USER_EMAIL=
WEBSITE=

# ── AI providers (fill at least one) ──
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# Optional proxy, only needed if your network requires it
HTTPS_PROXY=

# ── Sending mailbox (leave empty to run the demo without sending email) ──
# Gmail example: SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  (use an app password)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_NAME=

# ── Receiving mailbox (leave empty to run without fetching replies) ──
# Gmail example: IMAP_HOST=imap.gmail.com  IMAP_PORT=993
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# ── Backups ──
# Optional: set to encrypt cloud backups
BACKUP_PASSWORD=
# Optional: a cloud-synced folder (OneDrive / Dropbox / Google Drive)
BACKUP_CLOUD_DIR=

# ── Access restriction (optional) ──
APP_USER=
APP_PASSWORD=
